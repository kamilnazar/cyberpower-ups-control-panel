[Unit]
Description=CyberPower UPS history recorder
Documentation=file:%h/.config/omarchy/plugins/io.github.kamil.cyberpower-ups/README.md
# The recorder opens /dev/hidraw* itself, so it wants the bundled udev rule
# (udev/60-cyberpower-ups.rules) installed for the logged-in user. The seat
# sets that rule up, so the recorder waits for the session rather than
# starting before the node is readable.
#
# The unit is enabled into graphical-session.target.wants, so the target
# starts the recorder. It must NOT pull the target in with Wants=:
# graphical-session.target is what uwsm uses to decide whether a compositor
# session is already running, so pulling it in from a unit that starts with
# default.target makes uwsm refuse to start the compositor ("A compositor or
# graphical-session* target is already active!") and the session dies with a
# black screen. After= and PartOf= give the ordering without the pull-in.
After=graphical-session.target
PartOf=graphical-session.target
# A plugin installed somewhere else needs this path changed too.
ConditionPathExists=%h/.config/omarchy/plugins/io.github.kamil.cyberpower-ups/bin/cyberpower-ups
# A wrong path should not be retried forever.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.config/omarchy/plugins/io.github.kamil.cyberpower-ups/bin/cyberpower-ups watch --listen --interval 60
# --listen reads the reports the UPS pushes by itself, so a status change is
# recorded in about ten seconds instead of at the next reading. --interval is
# still how often a full reading is taken, which keeps the sample series
# regular and catches the values the device never pushes (a battery that needs
# replacing, the input frequency). The reader tolerates a missing device by
# itself and records one line when it goes away.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=graphical-session.target
